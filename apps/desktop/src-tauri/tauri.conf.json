{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenix AI Studio",
  "version": "0.1.0",
  "identifier": "com.zenix.aistudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Zenix AI Studio", "width": 1320, "height": 840, "minWidth": 950, "minHeight": 650 }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
